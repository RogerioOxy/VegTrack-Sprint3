{
  "expo": {
    "name": "VegTrack",
    "slug": "vegtrack",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.motiva.vegtrack",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15803d"
      },
      "package": "br.com.motiva.vegtrack",
      "versionCode": 1,
      "permissions": []
    },
    "plugins": [],
    "web": {
      "bundler": "metro",
      "shortName": "VegTrack",
      "favicon": "./assets/icon.png",
      "name": "VegTrack"
    }
  }
}
